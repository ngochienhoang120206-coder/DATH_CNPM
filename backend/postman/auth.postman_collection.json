{
  "info": {
    "name": "DATH Auth API acceptance tests",
    "description": "Automated auth flow: register, login, RBAC, profile, reset email, reset token, and logout. Run with the local Postman environment generated by npm run test:auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Unauthenticated profile is rejected",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/profile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('profile requires authentication', function () { pm.response.to.have.status(401); });"] } }]
    },
    {
      "name": "Register cannot assign a privileged role",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const runId = Date.now() + Math.floor(Math.random() * 100000);", "pm.environment.set('testEmail', `postman-${runId}@example.test`);"] } }, { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('register succeeds and role remains student', function () {", "  pm.response.to.have.status(201);", "  const body = pm.response.json();", "  pm.expect(body.data.role).to.eql('student');", "  pm.expect(body.data).to.not.have.property('password');", "  pm.environment.set('testUserId', body.data.id);", "});"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"fullName\": \"Postman Auth Test\",\n  \"password\": \"{{initialPassword}}\",\n  \"roleName\": \"admin\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/register" }
    },
    {
      "name": "Banned user cannot log in",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{bannedEmail}}\",\n  \"password\": \"{{bannedPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('banned login returns 403', function () { pm.response.to.have.status(403); });"] } }]
    },
    {
      "name": "Banned user cannot access profile",
      "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "access_token={{bannedAccessToken}}" }], "url": "{{baseUrl}}/api/users/profile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('banned protected request returns 403', function () { pm.response.to.have.status(403); });"] } }]
    },
    {
      "name": "Wrong password is rejected",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Wrong-Postman-Pass-999!\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('wrong password returns 401', function () { pm.response.to.have.status(401); });"] } }]
    },
    {
      "name": "Login sets secure role-bearing 24-hour cookie",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{initialPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('login returns role and 24-hour JWT in cookie', function () {", "  pm.response.to.have.status(200);", "  const cookie = pm.response.headers.get('Set-Cookie');", "  pm.expect(cookie).to.match(/access_token=[^;]+/i);", "  pm.expect(cookie).to.match(/HttpOnly/i);", "  pm.expect(cookie).to.match(/SameSite=Lax/i);", "  const shouldBeSecure = String(pm.environment.get('expectSecure')) === 'true';", "  pm.expect(/;\\s*Secure(?:;|$)/i.test(cookie)).to.eql(shouldBeSecure);", "  const token = cookie.match(/access_token=([^;]+)/i)[1];", "  const payloadPart = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');", "  const payload = JSON.parse(atob(payloadPart + '='.repeat((4 - payloadPart.length % 4) % 4)));", "  pm.expect(payload.role).to.eql('student');", "  pm.expect(payload.userId).to.eql(pm.environment.get('testUserId'));", "  pm.expect(payload.exp - payload.iat).to.eql(86400);", "  pm.environment.set('accessToken', token);", "});"] } }]
    },
    {
      "name": "Get profile with cookie",
      "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "access_token={{accessToken}}" }], "url": "{{baseUrl}}/api/users/profile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('profile is returned for authenticated user', function () {", "  pm.response.to.have.status(200);", "  const body = pm.response.json();", "  const role = typeof body.data.role === 'string' ? body.data.role : body.data.role?.name;", "  pm.expect(body.data.id).to.eql(pm.environment.get('testUserId'));", "  pm.expect(role).to.eql('student');", "  pm.expect(body.data).to.not.have.property('password');", "});"] } }]
    },
    {
      "name": "Update profile fields",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cookie", "value": "access_token={{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Postman Updated Name\",\n  \"avatar_url\": \"https://example.test/avatar.png\",\n  \"bio\": \"Updated by Postman acceptance test\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/users/profile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('allowed profile fields update', function () {", "  pm.response.to.have.status(200);", "  const data = pm.response.json().data;", "  pm.expect(data.full_name).to.eql('Postman Updated Name');", "  pm.expect(data.avatar_url).to.eql('https://example.test/avatar.png');", "  pm.expect(data.bio).to.eql('Updated by Postman acceptance test');", "});"] } }]
    },
    {
      "name": "Profile update rejects role changes",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cookie", "value": "access_token={{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"role\": \"admin\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/users/profile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('profile cannot alter role', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "Request password reset",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/forgot-password" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('forgot password response does not reveal account existence', function () {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().message).to.match(/If the account exists|Nếu tài khoản tồn tại/);", "});"] } }]
    },
    {
      "name": "Find reset email in Mailpit",
      "request": { "method": "GET", "url": "{{mailpitUrl}}/api/v1/search?query=to%3A{{testEmail}}&limit=10" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('reset email was delivered to test inbox', function () {", "  pm.response.to.have.status(200);", "  const messages = pm.response.json().messages || [];", "  const message = messages.find((item) => (item.To || []).some((address) => address.Address === pm.environment.get('testEmail')));", "  pm.expect(message, 'matching reset email').to.exist;", "  pm.environment.set('mailpitMessageId', message.ID);", "});"] } }]
    },
    {
      "name": "Extract reset token from email",
      "request": { "method": "GET", "url": "{{mailpitUrl}}/api/v1/message/{{mailpitMessageId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('email contains a 64-character reset token', function () {", "  pm.response.to.have.status(200);", "  const message = pm.response.json();", "  const match = `${message.Text || ''} ${message.HTML || ''}`.match(/[?&]token=([a-f0-9]{64})/i);", "  pm.expect(match, 'reset token in email').to.exist;", "  pm.environment.set('resetToken', match[1]);", "});"] } }]
    },
    {
      "name": "Reset password with emailed token",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/reset-password" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('valid reset token changes password', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Reset token cannot be reused",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{initialPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/reset-password" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('used reset token is rejected', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "Old password no longer works",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{initialPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('old password is rejected after reset', function () { pm.response.to.have.status(401); });"] } }]
    },
    {
      "name": "New password works",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('new password logs in', function () {", "  pm.response.to.have.status(200);", "  const cookie = pm.response.headers.get('Set-Cookie');", "  pm.environment.set('accessToken', cookie.match(/access_token=([^;]+)/i)[1]);", "});"] } }]
    },
    {
      "name": "Logout clears the session cookie",
      "request": { "method": "POST", "header": [{ "key": "Cookie", "value": "access_token={{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/logout" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('logout clears access cookie', function () {", "  pm.response.to.have.status(200);", "  const cookie = pm.response.headers.get('Set-Cookie');", "  pm.expect(cookie).to.match(/access_token=/i);", "  pm.expect(cookie).to.match(/expires=.*1970/i);", "  pm.expect(cookie).to.match(/HttpOnly/i);", "});"] } }]
    }
  ]
}
