generator client {
  provider = "prisma-client-js"
  output   = "../src/common/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================
enum users_status {
  active
  banned
}

enum enrollments_status {
  enrolled
  left
  completed
}

enum materials_type {
  video
  text
}

enum assessments_type {
  quiz
  file_upload
}

enum notifications_type {
  new_content
  deadline_reminder
  grade_released
  system
}

enum reports_status {
  pending
  resolved
  rejected
}

// =====================================================
// CỤM 1: TÀI KHOẢN VÀ PHÂN QUYỀN
// =====================================================
model roles {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique @db.VarChar(50) // instructor | student | admin
  deletedBy String?   @db.Uuid
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  users     users[]
}

model users {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id             String       @db.Uuid
  email               String       @unique @db.VarChar(255)
  full_name           String       @db.VarChar(255)
  password            String       @db.VarChar(255) // chuỗi đã băm (bcrypt/argon2), KHÔNG lưu plain text
  avatar_url          String?      @db.VarChar(500)
  bio                 String?
  status              users_status @default(active)
  is_verified         Boolean?     @default(false)
  verify_token        String?      @db.VarChar(255)
  verify_token_expiry DateTime?    @db.Timestamptz(6)
  reset_token         String?      @db.VarChar(255)
  reset_token_expiry  DateTime?    @db.Timestamptz(6)
  deletedBy           String?      @db.Uuid
  isDeleted           Boolean?     @default(false)
  deletedAt           DateTime?    @db.Timestamptz(6)
  createdAt           DateTime?    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime?    @default(now()) @updatedAt @db.Timestamptz(6)

  role              roles           @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  courses           courses[]
  enrollments       enrollments[]
  submissions       submissions[]   @relation("submission_owner")
  graded_submissions submissions[]  @relation("submission_grader")
  comments          comments[]
  notifications     notifications[]
  reports           reports[]
  admin_logs        admin_logs[]
  hosted_sessions   sessions[]
  reviews           reviews[]

  @@index([role_id], map: "idx_users_role_id")
}

// =====================================================
// CỤM 2: KHÓA HỌC VÀ NỘI DUNG
// =====================================================
model categories {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  deletedBy String?   @db.Uuid
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  courses   courses[]
}

model courses {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id String    @db.Uuid
  category_id   String?   @db.Uuid // SOFT DELETE: xóa mềm category thì service phải UPDATE về NULL trong transaction
  title         String    @db.VarChar(255)
  description   String?
  prerequisites String? // yêu cầu đầu vào
  thumbnail_url String?   @db.VarChar(500)
  is_published  Boolean   @default(false)
  published_at  DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  isDeleted     Boolean?  @default(false)
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  instructor   users          @relation(fields: [instructor_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category     categories?    @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  chapters     chapters[]
  enrollments  enrollments[]
  assessments  assessments[]
  reports      reports[]
  sessions     sessions[]
  reviews      reviews[]

  @@index([instructor_id], map: "idx_courses_instructor_id")
  @@index([category_id], map: "idx_courses_category_id")
}

model chapters {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id String    @db.Uuid
  title     String    @db.VarChar(255)
  position  Int
  deletedBy String?   @db.Uuid
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  course  courses   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessons lessons[]

  @@unique([course_id, position], map: "uq_chapters_course_position")
  @@index([course_id], map: "idx_chapters_course_id")
}

model lessons {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapter_id String    @db.Uuid
  title      String    @db.VarChar(255)
  position   Int
  deletedBy  String?   @db.Uuid
  isDeleted  Boolean?  @default(false)
  deletedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  chapter           chapters      @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  materials         materials[]
  progress          progress[]
  comments          comments[]
  assessments       assessments[]
  last_lesson_of    enrollments[]

  @@unique([chapter_id, position], map: "uq_lessons_chapter_position")
  @@index([chapter_id], map: "idx_lessons_chapter_id")
}

model materials {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id        String         @db.Uuid
  type             materials_type
  title            String?        @db.VarChar(255)
  url              String? // link video (type = video)
  content          String? // nội dung văn bản (type = text)
  duration_seconds Int?
  position         Int            @default(0)
  deletedBy        String?        @db.Uuid
  isDeleted        Boolean?       @default(false)
  deletedAt        DateTime?      @db.Timestamptz(6)
  createdAt        DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)

  lesson lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lesson_id], map: "idx_materials_lesson_id")
}

// =====================================================
// CỤM 3: ĐĂNG KÝ VÀ HỌC TẬP
// =====================================================
model enrollments {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String             @db.Uuid
  course_id        String             @db.Uuid
  status           enrollments_status @default(enrolled)
  progress_percent Decimal            @default(0) @db.Decimal(5, 2)
  last_lesson_id   String?            @db.Uuid // bài học gần nhất; SOFT DELETE lesson thì service phải UPDATE về NULL trong transaction
  enrolled_at      DateTime           @default(now()) @db.Timestamptz(6)
  left_at          DateTime?          @db.Timestamptz(6)
  completed_at     DateTime?          @db.Timestamptz(6)
  deletedBy        String?            @db.Uuid
  isDeleted        Boolean?           @default(false)
  deletedAt        DateTime?          @db.Timestamptz(6)
  createdAt        DateTime?          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?          @default(now()) @updatedAt @db.Timestamptz(6)

  user        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course      courses    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  last_lesson lessons?   @relation(fields: [last_lesson_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  progress    progress[]

  // Đăng ký lại khóa (status = left hoặc isDeleted = true) phải dùng UPSERT, không INSERT
  @@unique([user_id, course_id], map: "uq_enrollments_user_course")
  @@index([course_id], map: "idx_enrollments_course_id")
}

model progress {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollment_id         String    @db.Uuid
  lesson_id             String    @db.Uuid
  is_completed          Boolean   @default(false)
  last_position_seconds Int?
  completed_at          DateTime? @db.Timestamptz(6)
  createdAt             DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  enrollment enrollments @relation(fields: [enrollment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson     lessons     @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([enrollment_id, lesson_id], map: "uq_progress_enrollment_lesson")
  @@index([lesson_id], map: "idx_progress_lesson_id")
}

// =====================================================
// CỤM 4: BÀI TẬP VÀ ĐÁNH GIÁ
// =====================================================
model assessments {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id          String           @db.Uuid
  lesson_id          String?          @db.Uuid // SOFT DELETE lesson thì service phải UPDATE về NULL trong transaction
  type               assessments_type
  title              String           @db.VarChar(255)
  description        String?
  time_limit_minutes Int?
  due_at             DateTime?        @db.Timestamptz(6)
  max_attempts       Int              @default(1)
  pass_score         Decimal?         @db.Decimal(5, 2)
  deletedBy          String?          @db.Uuid
  isDeleted          Boolean?         @default(false)
  deletedAt          DateTime?        @db.Timestamptz(6)
  createdAt          DateTime?        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)

  course      courses       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson      lessons?      @relation(fields: [lesson_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  questions   questions[]
  submissions submissions[]

  @@index([course_id], map: "idx_assessments_course_id")
  @@index([lesson_id], map: "idx_assessments_lesson_id")
}

model questions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id String    @db.Uuid
  content       String
  points        Int       @default(1)
  position      Int       @default(0)
  deletedBy     String?   @db.Uuid
  isDeleted     Boolean?  @default(false)
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  assessment assessments @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answers    answers[]

  @@index([assessment_id], map: "idx_questions_assessment_id")
}

model answers {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id String    @db.Uuid
  content     String
  is_correct  Boolean   @default(false)
  position    Int       @default(0)
  deletedBy   String?   @db.Uuid
  isDeleted   Boolean?  @default(false)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  question questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id], map: "idx_answers_question_id")
}

model submissions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id String    @db.Uuid
  user_id       String    @db.Uuid // dùng để API check: submission này có thuộc user đang đăng nhập không
  attempt_no    Int       @default(1)
  file_url      String? // bài nộp tệp
  answers_data  Json? // đáp án học viên chọn: { question_id: answer_id }
  score         Decimal?  @db.Decimal(5, 2)
  feedback      String?
  graded_by     String?   @db.Uuid
  graded_at     DateTime? @db.Timestamptz(6)
  submitted_at  DateTime  @default(now()) @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  isDeleted     Boolean?  @default(false)
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  assessment assessments @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       users       @relation("submission_owner", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grader     users?      @relation("submission_grader", fields: [graded_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([assessment_id, user_id, attempt_no], map: "uq_submissions_attempt")
  @@index([user_id], map: "idx_submissions_user_id")
}

// =====================================================
// CỤM 5: TƯƠNG TÁC VÀ THÔNG BÁO
// =====================================================
model comments {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id String    @db.Uuid
  user_id   String    @db.Uuid
  parent_id String?   @db.Uuid // trả lời một comment khác
  content   String
  deletedBy String?   @db.Uuid
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  lesson  lessons    @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent  comments?  @relation("comment_replies", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies comments[] @relation("comment_replies")
  reports reports[]

  @@index([lesson_id], map: "idx_comments_lesson_id")
  @@index([user_id], map: "idx_comments_user_id")
  @@index([parent_id], map: "idx_comments_parent_id")
}

model notifications {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String             @db.Uuid
  type      notifications_type
  message   String
  link      String?            @db.VarChar(500)
  is_read   Boolean            @default(false)
  createdAt DateTime?          @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notifications_user_read")
}

model reports {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id String         @db.Uuid
  comment_id  String?        @db.Uuid
  course_id   String?        @db.Uuid
  reason      String
  status      reports_status @default(pending)
  deletedBy   String?        @db.Uuid
  isDeleted   Boolean?       @default(false)
  deletedAt   DateTime?      @db.Timestamptz(6)
  createdAt   DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)

  reporter users     @relation(fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comment  comments? @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course   courses?  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_reports_status")
}

model reviews {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id String    @db.Uuid
  user_id   String    @db.Uuid
  rating    Int // 1..5, thêm CHECK (rating BETWEEN 1 AND 5) trong migration SQL
  comment   String?
  deletedBy String?   @db.Uuid
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  course courses @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([course_id, user_id], map: "uq_reviews_course_user")
}

// =====================================================
// CỤM 6: QUẢN TRỊ (KHÔNG soft delete, KHÔNG cascade: giữ lịch sử vĩnh viễn)
// =====================================================
model admin_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String    @db.Uuid
  action      String    @db.VarChar(100) // vd: DELETE_COURSE, BAN_USER
  target_type String?   @db.VarChar(50)
  target_id   String?   @db.Uuid
  detail      Json?
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)

  admin users @relation(fields: [admin_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([admin_id], map: "idx_admin_logs_admin_id")
  @@index([createdAt], map: "idx_admin_logs_created_at")
}

// =====================================================
// CỤM 7: PHÒNG HỌC THỜI GIAN THỰC (chỉ lưu SNAPSHOT cuối phiên;
// tọa độ nét vẽ / con trỏ chuột nằm ở Redis, KHÔNG lưu ở đây)
// =====================================================
model sessions {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id           String    @db.Uuid
  host_id             String    @db.Uuid
  started_at          DateTime  @default(now()) @db.Timestamptz(6)
  ended_at            DateTime? @db.Timestamptz(6)
  whiteboard_snapshot Json?
  code_snapshot       String?
  notes_snapshot      String? // ghi chú của buổi học (Proposal: board, notes, code đều được lưu lại)
  deletedBy           String?   @db.Uuid
  isDeleted           Boolean?  @default(false)
  deletedAt           DateTime? @db.Timestamptz(6)
  createdAt           DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  course courses @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  host   users   @relation(fields: [host_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([course_id], map: "idx_sessions_course_id")
  @@index([host_id], map: "idx_sessions_host_id")
}
